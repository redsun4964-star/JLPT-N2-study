<!DOCTYPE html>
<html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>N2 학습 노트</title>
<style>
:root{--bg:#f4f6f3;--card:#fff;--ink:#16211d;--mute:#5d6b65;--line:#d5ddd8;--mark:#0f6b5c}
@media (prefers-color-scheme:dark){:root{--bg:#121816;--card:#1b2320;--ink:#e6ece9;--mute:#9aa8a2;--line:#2c3733;--mark:#5fd0b8}}
body{margin:0;min-height:100vh;display:grid;place-items:center;background:var(--bg);color:var(--ink);font:15px/1.6 system-ui,-apple-system,"Noto Sans KR",sans-serif}
form{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:24px;width:min(340px,calc(100vw - 32px));box-sizing:border-box;display:flex;flex-direction:column;gap:12px}
h1{font-size:19px;margin:0}p{margin:0;color:var(--mute);font-size:13px}
input{font:inherit;color:inherit;background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:10px 12px}
button{font:inherit;font-weight:600;background:var(--mark);color:var(--card);border:0;border-radius:8px;padding:11px;cursor:pointer}
input:focus-visible,button:focus-visible{outline:2px solid var(--mark);outline-offset:2px}
#msg{min-height:1.4em;color:#c0392b}
label{font-size:13px;color:var(--mute);display:flex;gap:6px;align-items:center}
</style></head><body>
<form id="f"><h1>N2 학습 노트</h1><p>비밀번호를 입력하세요.</p>
<input id="pw" type="password" autocomplete="current-password" aria-label="비밀번호" autofocus>
<label><input id="keep" type="checkbox" checked> 이 기기에서 기억하기</label>
<button type="submit">열기</button><p id="msg" role="alert"></p></form>
<script>
(()=>{
const D={"s": "fJqCd+lr4pLfPsUdU0YHTA==", "i": "zefKIn8bPR+Hgmaa", "n": 250000, "c": ""};
const dec=s=>Uint8Array.from(atob(s),c=>c.charCodeAt(0));
async function open_(pw){
  const km=await crypto.subtle.importKey('raw',new TextEncoder().encode(pw),'PBKDF2',false,['deriveKey']);
  const key=await crypto.subtle.deriveKey({name:'PBKDF2',salt:dec(D.s),iterations:D.n,hash:'SHA-256'},km,{name:'AES-GCM',length:256},false,['decrypt']);
  const buf=await crypto.subtle.decrypt({name:'AES-GCM',iv:dec(D.i)},key,dec(D.c));
  return new TextDecoder().decode(buf)}
function show(html){document.open();document.write(html);document.close()}
const K='n2note-pass',msg=document.getElementById('msg');
(async()=>{let saved=null;try{saved=localStorage.getItem(K)}catch(e){}
  if(saved){try{show(await open_(saved))}catch(e){try{localStorage.removeItem(K)}catch(e){}}}})();
document.getElementById('f').addEventListener('submit',async e=>{e.preventDefault();
  if(!window.crypto||!crypto.subtle){msg.textContent='이 브라우저에서는 열 수 없습니다. https 주소로 접속하세요.';return}
  const pw=document.getElementById('pw').value;msg.textContent='확인 중…';
  try{const html=await open_(pw);if(document.getElementById('keep').checked){try{localStorage.setItem(K,pw)}catch(e){}}show(html)}
  catch(err){msg.textContent='비밀번호가 맞지 않습니다.'}});
})();
</script></body></html>
